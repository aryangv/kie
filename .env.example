# Kie configuration — copy this file to ".env" and fill in what you want.
#   cp .env.example .env
#
# Everything here is OPTIONAL. With no keys at all, Kie still works:
# Hacker News, Lobsters and GitHub-trending need no credentials; Reddit and X
# disable themselves; GitHub uses the lower anonymous rate limit. All keys are
# bring-your-own and stay on this machine. .env is git-ignored.

# ---- GitHub -----------------------------------------------------------------
# A personal access token raises the GitHub API limit from 60 to 5000 req/hr.
# Needs NO scopes — public read is enough. Create one at:
#   https://github.com/settings/tokens  (classic, no scopes)  OR
#   https://github.com/settings/tokens?type=beta  (fine-grained, Public repos: read-only)
GITHUB_TOKEN=

# ---- Reddit (enables the Reddit source) -------------------------------------
# Free "script" app: https://www.reddit.com/prefs/apps  -> create app -> "script".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: comma-separated subreddits to scan (defaults to a dev-focused set).
# REDDIT_SUBREDDITS=programming,MachineLearning,webdev,rust,golang

# ---- X / Twitter (enables the X source) -------------------------------------
# Your X API v2 bearer token. NOTE: the recent-search endpoint requires a PAID
# X API tier; on a tier that doesn't grant it, the source is simply skipped.
X_BEARER_TOKEN=
# Optional: override the recent-search query.
# X_SEARCH_QUERY=

# ---- Lobsters (no key needed) -----------------------------------------------
# Feeds to merge (comma-separated). Each maps to https://lobste.rs/<entry>.json.
# Add tag feeds like "t/rust" or "t/programming" to widen coverage.
# LOBSTERS_FEEDS=hottest,newest

# ---- Profile / storage ------------------------------------------------------
# Directories to scan for your stack (";" or "," separated). Default: ~/code
# KIE_CODE_ROOTS=C:\Users\aryan\code
# SQLite database path. Default: ~/.kie/kie.db
# KIE_DB=
# Path to a .env file to load (overrides the default search).
# KIE_ENV_FILE=

# ---- Tuning -----------------------------------------------------------------
# Lazy-refresh TTL in hours: a tool call older than this re-collects first. Default: 6
# KIE_MAX_CACHE_AGE_HOURS=6
# Max repos enriched via GitHub per refresh. Default: 45 (no token) / 200 (token)
# KIE_ENRICH_CAP=
# Skip re-enriching a repo refreshed more recently than this many hours. Default: 24
# KIE_ENRICH_FRESH_HOURS=24
# SQLite busy_timeout (ms) so concurrent background writers wait instead of erroring. Default: 5000
# KIE_BUSY_TIMEOUT_MS=5000

# ---- Daemon (background "what's new" digest) --------------------------------
# Minutes between daemon passes. Default: 360 (6h)
# KIE_DIGEST_INTERVAL_MIN=360
# Where the daemon writes the digest. Default: ~/.kie/digest.md
# KIE_DIGEST_PATH=
